{
  "name": "chardb",
  "version": "11.9.0",
  "private": true,
  "packageManager": "yarn@4.10.2+sha512.0b0e54ad5381f0a35184957bd3ea44e37f5a4fb1960b903b0fb9a3c7c2c009190455c41ef2a1977b1dbd3b72c5f152da696e9c52e2bc78a011b6adea8ee73ba3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "dev": "node scripts/with-instance.mjs concurrently \"yarn workspace @chardb/backend dev\" \"yarn workspace @chardb/frontend dev\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "dev:backend": "yarn workspace @chardb/backend dev",
    "dev:frontend": "yarn workspace @chardb/frontend dev",
    "dev:agent": "yarn dev | tee dev.log",
    "instance": "node scripts/instance.mjs",
    "instance:init": "node scripts/instance-init.mjs",
    "instance:list": "node scripts/instance.mjs --list",
    "instance:release": "node scripts/instance.mjs --release",
    "instance:down": "node scripts/instance-down.mjs",
    "instance:prune": "node scripts/instance.mjs --prune",
    "instance:reset": "node scripts/instance.mjs --reset",
    "dc": "node scripts/with-instance.mjs docker compose -f docker/compose.yaml -f docker/compose.override.yaml",
    "instance:up": "yarn dc up -d --wait postgres localstack",
    "shared:up": "docker compose -f docker/compose.shared.yml up -d --wait",
    "shared:down": "docker compose -f docker/compose.shared.yml down",
    "test": "yarn workspaces foreach -A run test",
    "lint": "eslint .",
    "type-check": "yarn workspaces foreach -A run type-check",
    "clean": "yarn workspaces foreach -A run clean",
    "prepare": "husky",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,css,html}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,css,html}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "1.0.17"
  }
}
