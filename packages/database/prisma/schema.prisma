generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum MediaType {
  IMAGE
  TEXT
}

enum TextFormatting {
  PLAINTEXT
  MARKDOWN
}

enum TraitValueType {
  STRING
  TIMESTAMP
  INTEGER
  ENUM
}

enum ExternalAccountProvider {
  DEVIANTART
  DISCORD
  TOYHOUSE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ModerationRejectionReason {
  TOS_VIOLATION
  NSFW_NOT_TAGGED
  SPAM_LOW_QUALITY
  COPYRIGHT_ISSUE
  OTHER
}

/// How an item moved. One row per item per event, so the kind alone says what
/// happened -- there is no quantity to interpret.
enum ItemTransactionKind {
  GRANT
  REVOKE
  TRANSFER
  CLAIM
  USE
  /// Written once, by the migration that introduced this table, for every item
  /// that already existed. Says only "this item predates the ledger" -- its
  /// real origin is unknown, and inventing a GRANT for it would put fabricated
  /// provenance on a page members can read.
  IMPORT
}

/// What caused an item to move.
///
/// Deliberately a separate enum from CurrencyTransactionSource rather than one
/// shared across both ledgers. Sharing would be tidier, but that enum has
/// already shipped and renaming it costs a migration to save two duplicated
/// values -- and the two lists are free to diverge, which they will.
enum ItemTransactionSource {
  /// Somebody acted directly, with no other record behind it.
  DIRECT
  /// Granted by a community shop purchase. Source id is the purchase line.
  SHOP_PURCHASE
  /// An MYO ticket spent making a character. Source id is the character, which
  /// outlives a rejection as a soft delete, so the link stays followable.
  MYO_REDEMPTION
  /// A ticket handed back because the character it made was refused at trait
  /// review. Source id is the review. Paired with kind GRANT: the member is
  /// given a fresh ticket, because the one they spent stays spent and keeps
  /// its history.
  MYO_REJECTION
  /// An edit kit spent proposing a change to a character's traits. Source id
  /// is the character. Unlike an MYO redemption the character is not changed
  /// by this -- the proposal waits in the review until staff approve it.
  TRAIT_EDIT_REDEMPTION
  /// A kit handed back because the edit it proposed was refused. Source id is
  /// the review. Same pairing as MYO_REJECTION: kind GRANT, a fresh item.
  TRAIT_EDIT_REJECTION
}

enum TraitReviewSource {
  IMPORT
  MYO
  USER_EDIT
  CREATION
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique @db.VarChar(30)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(100)
  bio             String?   @db.Text
  avatarImageId   String?   @map("avatar_image_id")
  website         String?   @db.VarChar(500)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  isVerified      Boolean   @default(false) @map("is_verified")
  isAdmin         Boolean   @default(false) @map("is_admin")
  privacySettings Json      @default("{}") @map("privacy_settings")

  // Identity permission fields (migrated from clovercoin-app Identity model)
  canCreateCommunity        Boolean @default(false) @map("can_create_community")
  canListUsers              Boolean @default(false) @map("can_list_users")
  canListInviteCodes        Boolean @default(false) @map("can_list_invite_codes")
  canCreateInviteCode       Boolean @default(false) @map("can_create_invite_code")
  canGrantGlobalPermissions Boolean @default(false) @map("can_grant_global_permissions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  avatarImage       Image?      @relation("UserAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)
  ownedCharacters   Character[] @relation("CharacterOwner")
  createdCharacters Character[] @relation("CharacterCreator")
  deletedCharacters Character[] @relation("CharacterDeletedBy")
  uploadedImages    Image[]     @relation("ImageUploader")
  artistImages      Image[]     @relation("ImageArtist")
  media             Media[]
  galleries         Gallery[]
  comments          Comment[]
  profileComments   Comment[]   @relation("UserComments")
  likes             Like[]

  // Social relations
  followers Follow[] @relation("UserFollowing")
  following Follow[] @relation("UserFollower")

  // Community membership relations
  communityMemberships CommunityMember[]     @relation
  receivedInvitations  CommunityInvitation[] @relation("ReceivedInvitations")
  createdInvitations   CommunityInvitation[] @relation("CreatedInvitations")
  createdInviteCodes   InviteCode[]

  // Character ownership change tracking
  ownershipChangesFrom CharacterOwnershipChange[] @relation("CharacterOwnershipChangeFrom")
  ownershipChangesTo   CharacterOwnershipChange[] @relation("CharacterOwnershipChangeTo")

  // External account linking
  externalAccounts ExternalAccount[]

  // Inventory relations
  items          Item[] @relation("UserItems")
  destroyedItems Item[] @relation("ItemDestroyer")

  // Item ledger. Three separate relations because one row can name three
  // different people: who it left, who it reached, and who did it.
  itemTransactionsFrom  ItemTransaction[] @relation("ItemTransactionFrom")
  itemTransactionsTo    ItemTransaction[] @relation("ItemTransactionTo")
  itemTransactionsActed ItemTransaction[] @relation("ItemTransactionActor")

  // Currency. A balance per currency held, plus the statement rows behind it.
  currencyBalances                 CurrencyBalance[]
  currencyTransactions             CurrencyTransaction[] @relation("CurrencyTransactionUser")
  currencyTransactionsCounterparty CurrencyTransaction[] @relation("CurrencyTransactionCounterparty")
  currencyTransactionsActed        CurrencyTransaction[] @relation("CurrencyTransactionActor")
  shopPurchases                    ShopPurchase[]        @relation("ShopPurchaseBuyer")
  shopLinesRefunded                ShopPurchaseLine[]    @relation("ShopLineRefunder")

  // Pending ownership claims
  claimedPendingItems PendingOwnership[]

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Image moderation actions
  moderationActions ImageModerationAction[] @relation("ModeratorActions")

  // Trait review actions
  traitReviewActions TraitReview[] @relation("TraitReviewResolver")

  // Notifications. Two relations because one row names two people: who it was
  // addressed to, and who caused it.
  notifications      Notification[] @relation("NotificationRecipient")
  causedNotifications Notification[] @relation("NotificationActor")

  // Trading. Two relations for the offers themselves, and six more because
  // every line on the table names both ends of its own movement.
  proposedTrades           Trade[]             @relation("TradeProposer")
  receivedTrades           Trade[]             @relation("TradeRecipient")
  tradeItemsGiven          TradeItem[]         @relation("TradeItemSource")
  tradeItemsReceived       TradeItem[]         @relation("TradeItemDestination")
  tradeCharactersGiven     TradeCharacter[]    @relation("TradeCharacterSource")
  tradeCharactersReceived  TradeCharacter[]    @relation("TradeCharacterDestination")
  tradeCurrencyGiven       TradeCurrencyLine[] @relation("TradeCurrencySource")
  tradeCurrencyReceived    TradeCurrencyLine[] @relation("TradeCurrencyDestination")

  @@map("users")
}

model ExternalAccount {
  id                String                  @id @default(uuid())
  userId            String                  @map("user_id")
  provider          ExternalAccountProvider
  providerAccountId String                  @map("provider_account_id") @db.VarChar(255)
  displayName       String                  @map("display_name") @db.VarChar(100)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Constraints: one provider account can only be linked to one user, and one user can only link one account per provider
  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
  @@map("external_accounts")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Character {
  id                String            @id @default(uuid())
  name              String            @db.VarChar(100)
  registryId        String?           @map("registry_id") @db.VarChar(100)
  speciesId         String?           @map("species_id")
  speciesVariantId  String?           @map("species_variant_id")
  details           String?           @db.Text
  ownerId           String?           @map("owner_id")
  creatorId         String?           @map("creator_id")
  mainMediaId       String?           @map("main_media_id")
  visibility        Visibility        @default(PUBLIC)

  /// What the owner will entertain being asked about, each defaulting to no.
  ///
  /// All but `isTradeable` are advertisements. They say what an owner is open
  /// to and leave the arranging to a comment thread, which is what the things
  /// they describe actually are -- there is no mechanism here that settles a
  /// character for a piece of art. `isTradeable` is the exception and the
  /// reason the rest cannot simply be one "for offers" flag: the trade system
  /// reads it, at propose and again at settlement, so it is consent to a real
  /// transfer rather than a label. A character open to art trades has not
  /// thereby agreed to be put on a trade table.
  isSellable        Boolean           @default(false) @map("is_sellable")
  isSellableForCoin Boolean           @default(false) @map("is_sellable_for_coin")
  isTradeable       Boolean           @default(false) @map("is_tradeable")
  isTradeableForArt Boolean           @default(false) @map("is_tradeable_for_art")
  isOpenToOffers    Boolean           @default(false) @map("is_open_to_offers")
  isFreebie         Boolean           @default(false) @map("is_freebie")

  /// Asking price for `isSellable`, in real money. The coin equivalent has no
  /// price field: community currencies are per-community and a character
  /// reaches at most one, so a number here could not say which currency it was
  /// in without a second column to name it. Owners put the figure in the
  /// character's details until that is worth doing properly.
  price             Decimal?          @db.Decimal(10, 2)
  customFields      Json              @default("{}") @map("custom_fields")
  /// [CharacterTraitValuesJson]
  traitValues       Json              @default("[]") @map("trait_values")
  traitReviewStatus ModerationStatus? @map("trait_review_status")
  deletedAt         DateTime?         @map("deleted_at")
  deletedById       String?           @map("deleted_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  // SetNull, not Cascade: deleting a user must not destroy characters. They are
  // tradeable objects with history that matters to other people (ownership
  // changes, comments, galleries), and `ownerId` is already nullable -- the
  // codebase models ownerless characters as "orphaned" throughout.
  owner          User?           @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creator        User?           @relation("CharacterCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  deletedBy      User?           @relation("CharacterDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  mainMedia      Media?          @relation("CharacterMainMedia", fields: [mainMediaId], references: [id], onDelete: SetNull)
  species        Species?        @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  speciesVariant SpeciesVariant? @relation(fields: [speciesVariantId], references: [id], onDelete: SetNull)

  media     Media[]
  galleries Gallery[]
  comments  Comment[]
  likes     Like[]
  tags_rel  CharacterTag[]

  // Ownership change tracking
  ownershipChanges CharacterOwnershipChange[]

  /// Every offer this character has been named in, settled or not.
  tradeLines TradeCharacter[]

  // Pending ownership
  pendingOwnership PendingOwnership?

  // Trait reviews
  traitReviews TraitReview[]

  @@unique([speciesId, registryId])
  @@index([traitValues], type: Gin, map: "character_traitvalues_gin_idx")
  @@map("characters")
}

model Image {
  id               String  @id @default(uuid())
  filename         String  @db.VarChar(255)
  originalFilename String  @map("original_filename") @db.VarChar(255)
  originalUrl      String  @map("original_url") @db.Text
  mediumUrl        String? @map("medium_url") @db.Text
  thumbnailUrl     String? @map("thumbnail_url") @db.Text
  altText          String? @map("alt_text") @db.VarChar(200)
  uploaderId       String  @map("uploader_id")

  // Artist attribution
  artistId   String? @map("artist_id")
  artistName String? @map("artist_name") @db.VarChar(255)
  artistUrl  String? @map("artist_url") @db.VarChar(500)
  source     String? @db.VarChar(500)

  width                       Int
  height                      Int
  fileSize                    Int     @map("file_size")
  mimeType                    String  @map("mime_type") @db.VarChar(50)
  isNsfw                      Boolean @default(false) @map("is_nsfw")
  sensitiveContentDescription String? @map("sensitive_content_description") @db.Text

  // Moderation
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  uploader User  @relation("ImageUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  artist   User? @relation("ImageArtist", fields: [artistId], references: [id], onDelete: SetNull)

  comments          Comment[]
  likes             Like[]
  tags_rel          ImageTag[]
  media             Media[]
  userAvatars       User[]                  @relation("UserAvatar")
  itemTypes         ItemType[]              @relation("ItemTypeImage")
  moderationActions ImageModerationAction[]

  @@map("images")
}

model Gallery {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(100)
  description String?    @db.Text
  ownerId     String     @map("owner_id")
  characterId String?    @map("character_id")
  visibility  Visibility @default(PUBLIC)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  media    Media[]
  comments Comment[]
  likes    Like[]

  @@map("galleries")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Separate fields for each commentable type - only one will be non-null
  characterId String? @map("character_id")
  imageId     String? @map("image_id")
  mediaId     String? @map("media_id")
  galleryId   String? @map("gallery_id")
  userId      String? @map("user_id") // for user profile comments

  // Relations
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Self-referential relation for nested comments
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  // Relations with proper foreign key constraints
  character     Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  image         Image?     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  media         Media?     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  gallery       Gallery?   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  commentedUser User?      @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)

  likes Like[]

  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  follower  User @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Separate fields for each likeable type - only one will be non-null
  characterId String? @map("character_id")
  imageId     String? @map("image_id")
  mediaId     String? @map("media_id")
  galleryId   String? @map("gallery_id")
  commentId   String? @map("comment_id")

  // Relations with proper foreign key constraints
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  image     Image?     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  media     Media?     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  gallery   Gallery?   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  comment   Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@unique([userId, imageId])
  @@unique([userId, mediaId])
  @@unique([userId, galleryId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(50)
  category    String?  @db.VarChar(30)
  color       String?  @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  characters CharacterTag[]
  images     ImageTag[]
  media      MediaTag[]

  @@map("tags")
}

model CharacterTag {
  characterId String @map("character_id")
  tagId       String @map("tag_id")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
  @@map("character_tags")
}

model ImageTag {
  imageId String @map("image_id")
  tagId   String @map("tag_id")

  // Relations
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@map("image_tags")
}

model Media {
  id          String     @id @default(uuid())
  title       String     @db.VarChar(255)
  description String?    @db.Text
  ownerId     String     @map("owner_id")
  characterId String?    @map("character_id")
  galleryId   String?    @map("gallery_id")
  visibility  Visibility @default(PUBLIC)

  // Content references (exactly one must be non-null)
  imageId       String? @map("image_id")
  textContentId String? @map("text_content_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  gallery   Gallery?   @relation(fields: [galleryId], references: [id], onDelete: SetNull)

  // Content relations
  image       Image?       @relation(fields: [imageId], references: [id], onDelete: Cascade)
  textContent TextContent? @relation(fields: [textContentId], references: [id], onDelete: Cascade)

  mainMediaFor Character[] @relation("CharacterMainMedia")
  comments     Comment[]
  likes        Like[]
  tags_rel     MediaTag[]

  @@map("media")
}

model TextContent {
  id         String         @id @default(uuid())
  content    String         @db.Text
  wordCount  Int            @map("word_count")
  formatting TextFormatting @default(PLAINTEXT)

  // Relations
  media Media[]

  @@map("text_content")
}

model MediaTag {
  mediaId String @map("media_id")
  tagId   String @map("tag_id")

  // Relations
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@map("media_tags")
}

model Community {
  id               String   @id @default(uuid())
  name             String   @unique @db.VarChar(100)
  discordGuildId   String?  @map("discord_guild_id") @db.VarChar(30)
  discordGuildName String?  @map("discord_guild_name") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  species              Species[]
  roles                Role[]
  communityInvitations CommunityInvitation[]
  itemTypes            ItemType[]
  communityColors      CommunityColor[]
  itemTransactions     ItemTransaction[]
  currencies           Currency[]
  shopItems            ShopItem[]
  shopPurchases        ShopPurchase[]
  notifications        Notification[]
  trades               Trade[]

  @@map("communities")
}

model CommunityColor {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(50)
  hexCode     String   @map("hex_code") @db.VarChar(7)
  communityId String   @map("community_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  traits          Trait[]
  enumValues      EnumValue[]
  speciesVariants SpeciesVariant[]
  itemTypes       ItemType[]
  currencies      Currency[]

  @@unique([communityId, name])
  @@map("community_colors")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  communityId String   @map("community_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Community-scoped permissions
  canCreateSpecies            Boolean @default(false) @map("can_create_species")
  canCreateCharacter          Boolean @default(false) @map("can_create_character")
  canCreateOrphanedCharacter  Boolean @default(false) @map("can_create_orphaned_character")
  canEditCharacter            Boolean @default(false) @map("can_edit_character")
  canEditOwnCharacter         Boolean @default(false) @map("can_edit_own_character")
  canEditOwnCharacterRegistry Boolean @default(false) @map("can_edit_own_character_registry")
  canEditCharacterRegistry    Boolean @default(false) @map("can_edit_character_registry")
  canEditSpecies              Boolean @default(false) @map("can_edit_species")
  canCreateInviteCode         Boolean @default(false) @map("can_create_invite_code")
  canListInviteCodes          Boolean @default(false) @map("can_list_invite_codes")
  canCreateRole               Boolean @default(false) @map("can_create_role")
  canEditRole                 Boolean @default(false) @map("can_edit_role")
  canRemoveCommunityMember    Boolean @default(false) @map("can_remove_community_member")
  canManageMemberRoles        Boolean @default(false) @map("can_manage_member_roles")
  canManageItems              Boolean @default(false) @map("can_manage_items")
  canGrantItems               Boolean @default(false) @map("can_grant_items")
  canUploadOwnCharacterImages Boolean @default(false) @map("can_upload_own_character_images")
  canUploadCharacterImages    Boolean @default(false) @map("can_upload_character_images")
  canModerateImages           Boolean @default(false) @map("can_moderate_images")
  canDeleteCharacter          Boolean @default(false) @map("can_delete_character")

  // Relations
  community            Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityMembers     CommunityMember[]
  communityInvitations CommunityInvitation[]
  inviteCodes          InviteCode[]

  @@unique([communityId, name])
  @@map("roles")
}

model CommunityMember {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@map("community_members")
}

model CommunityInvitation {
  id          String    @id @default(uuid())
  roleId      String    @map("role_id")
  inviteeId   String    @map("invitee_id")
  inviterId   String    @map("inviter_id")
  communityId String    @map("community_id")
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  declinedAt  DateTime? @map("declined_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitee   User      @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter   User      @relation("CreatedInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_invitations")
}

model InviteCode {
  id         String   @id @db.VarChar(50)
  claimCount Int      @default(0) @map("claim_count")
  maxClaims  Int      @map("max_claims")
  creatorId  String   @map("creator_id")
  roleId     String?  @map("role_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  creator User  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  role    Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("invite_codes")
}

model CharacterOwnershipChange {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  fromUserId  String?  @map("from_user_id")
  toUserId    String   @map("to_user_id")

  /// Set when this move was one leg of something larger, and carries the same
  /// value as the `settlementBatchId` on the trade that caused it -- the same
  /// id the item and currency ledgers were written with. Null for a direct
  /// transfer, which is its own whole cause.
  ///
  /// Not a foreign key, for the reason the item ledger gives: a record of what
  /// happened must outlive the thing that made it happen.
  batchId String? @map("batch_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  fromUser  User?     @relation("CharacterOwnershipChangeFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User      @relation("CharacterOwnershipChangeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("character_ownership_changes")
}

model PendingOwnership {
  id String @id @default(uuid())

  // Exactly one must be set (enforced by CHECK constraint)
  characterId String? @unique @map("character_id")
  itemId      String? @unique @map("item_id")

  // External account info
  provider          ExternalAccountProvider
  providerAccountId String                  @map("provider_account_id") @db.VarChar(255)
  displayIdentifier String?                 @map("display_identifier") @db.VarChar(255)

  // Claiming info
  createdAt       DateTime  @default(now()) @map("created_at")
  claimedAt       DateTime? @map("claimed_at")
  claimedByUserId String?   @map("claimed_by_user_id")

  // Relations
  character     Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item          Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimedByUser User?      @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)

  // Constraints
  @@index([provider, providerAccountId])
  @@map("pending_ownership")
}

model ItemType {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String? @db.Text
  communityId String  @map("community_id")
  category    String? @db.VarChar(50)

  // Item properties. There is deliberately no stacking flag: every item is an
  // individually tracked row, and rolling several of them up into one tile is a
  // presentation choice the frontend makes, not a storage one.
  isTradeable Boolean @default(true) @map("is_tradeable")

  /// Whether a holder can use one up.
  ///
  /// Was a label with nothing behind it until using arrived. It is now the
  /// gate: using destroys the item, so anything that pays out has to be
  /// consumable or the payout is a currency printer. Enforced when a payout is
  /// configured, not merely documented here.
  isConsumable Boolean @default(false) @map("is_consumable")

  // Visual properties
  imageId String? @map("image_id")
  colorId String? @map("color_id")

  // Metadata
  metadata Json @default("{}") // Flexible properties

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  community    Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  color        CommunityColor?   @relation(fields: [colorId], references: [id], onDelete: SetNull)
  image        Image?            @relation("ItemTypeImage", fields: [imageId], references: [id], onDelete: SetNull)
  items        Item[]
  transactions ItemTransaction[]
  tradeLines   TradeItem[]
  ShopItem     ShopItem[]
  usePayout    ItemUsePayout?
  useMyoGrant  ItemUseMyoGrant?
  useTraitEditGrant ItemUseTraitEditGrant?

  @@unique([name, communityId])
  @@map("item_types")
}

/// One row per item. There is no quantity column and no stacking: three
/// potions are three rows.
///
/// Stacking and provenance cannot both be true. A row whose quantity went
/// 2 -> 4 -> 3 has no answerable history -- asked which two of the three came
/// from a given trade, it cannot say. Per-instance rows give every item one
/// unbroken chain, which is the whole point of provenance being public.
model Item {
  id         String  @id @default(uuid())
  itemTypeId String  @map("item_type_id")
  ownerId    String? @map("owner_id")

  // Item state
  metadata Json @default("{}") // Instance-specific data

  /// Set when revoked or consumed. Soft, not hard: a destroyed item keeps its
  /// provenance readable, which is exactly the history a dispute needs. Mirrors
  /// Character.deletedAt.
  destroyedAt   DateTime? @map("destroyed_at")
  destroyedById String?   @map("destroyed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  itemType    ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  owner       User?    @relation("UserItems", fields: [ownerId], references: [id], onDelete: Cascade)
  destroyedBy User?    @relation("ItemDestroyer", fields: [destroyedById], references: [id], onDelete: SetNull)

  // Pending ownership
  pendingOwnership PendingOwnership?

  // Every offer this item has been named in, settled or not.
  tradeLines TradeItem[]

  // Ledger
  transactions ItemTransaction[]

  // Inventory reads are always "this holder, live items only", and the holdings
  // view adds the type. Destroyed rows accumulate forever, so they are kept out
  // of the index rather than filtered after the fact.
  @@index([ownerId, destroyedAt, itemTypeId])
  @@index([itemTypeId, destroyedAt])
  @@map("items")
}

/// One row per item, per event. Granting twelve tokens writes twelve rows;
/// collapsing them back into "Granted 12" is the frontend's job, and `batchId`
/// is the exact key it groups on.
///
/// `communityId` and `itemTypeId` are denormalised so the two hot reads -- a
/// community's ledger and one item's provenance -- never join to filter.
model ItemTransaction {
  id          String              @id @default(uuid())
  communityId String              @map("community_id")
  itemTypeId  String              @map("item_type_id")
  itemId      String              @map("item_id")
  kind        ItemTransactionKind

  /// Shared by every row one operation wrote. Grouping on this is exact;
  /// grouping on a matching timestamp is a guess that breaks under load.
  batchId String @map("batch_id")

  /// Who it left. Null for a grant -- the item is minted, not moved.
  fromUserId  String? @map("from_user_id")
  /// Who it reached. Null for a revoke or a use -- the item is destroyed.
  toUserId    String? @map("to_user_id")
  /// Who performed it. Null for anything the system did on its own.
  actorUserId String? @map("actor_user_id")
  /// Names a non-user actor: "discord-bot", "system". Set exactly when
  /// actorUserId is null.
  actorLabel  String? @map("actor_label") @db.VarChar(50)

  /// Member-facing. Visible to anyone who can read the ledger.
  reason    String? @db.Text
  /// Staff-only. Never returned to a viewer without item permissions in this
  /// community. Keeps candid internal detail out of a public audit trail.
  staffNote String? @map("staff_note") @db.Text

  /// What caused this row. DIRECT means somebody simply did it.
  source   ItemTransactionSource @default(DIRECT)
  /// The id of the record named by `source`. Not a foreign key, for the same
  /// reason as on the currency ledger: a ledger row must outlive its cause.
  sourceId String?               @map("source_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  itemType  ItemType  @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromUser  User?     @relation("ItemTransactionFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User?     @relation("ItemTransactionTo", fields: [toUserId], references: [id], onDelete: SetNull)
  actorUser User?     @relation("ItemTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // One row per item per event means this table grows fastest of anything here,
  // so every read path it serves gets a covering leading column.
  @@index([communityId, createdAt])
  @@index([source, sourceId])
  @@index([itemId, createdAt])
  @@index([itemTypeId, createdAt])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([batchId])
  @@map("item_transactions")
}

/// A community-defined unit of account. A community may define any number of
/// them; they do not convert into one another and never leave their community.
model Currency {
  id          String  @id @default(uuid())
  communityId String  @map("community_id")
  name        String  @db.VarChar(50)
  /// Short display code, unique per community: "HC", "GEM".
  code        String  @db.VarChar(10)
  /// Optional glyph rendered before the amount. Falls back to the code.
  symbol      String? @db.VarChar(8)
  description String? @db.Text
  colorId     String? @map("color_id")

  /// Whether members may hand this to each other -- by trade or by a direct
  /// send. Staff grants, shop purchases and refunds are unaffected, so an
  /// untradeable currency is still earned and still spent; it just cannot
  /// move sideways.
  ///
  /// Both member-to-member routes or neither. Blocking trades while leaving
  /// `transferCurrency` open would be a rule with its own workaround sitting
  /// next to it.
  ///
  /// The same flag on ItemType means the same thing, which is why it shares
  /// the name: items have no direct transfer, so "tradeable" is already the
  /// whole of "can move between members" there.
  isTradeable Boolean @default(true) @map("is_tradeable")

  /// Archived currencies stop accepting new transactions but keep every
  /// balance and statement row readable. Deleting one would destroy the
  /// history of everything ever bought with it.
  ///
  /// Distinct from `isTradeable`: archiving retires the currency for
  /// everyone including staff, where an untradeable currency is fully alive
  /// and merely cannot be passed between members.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community             Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  color                 CommunityColor?        @relation(fields: [colorId], references: [id], onDelete: SetNull)
  balances              CurrencyBalance[]
  transactions          CurrencyTransaction[]
  tradeLines            TradeCurrencyLine[]
  shopPriceComponents   ShopPriceComponent[]
  shopPurchaseLineCosts ShopPurchaseLineCost[]
  itemUsePayouts        ItemUsePayoutComponent[]

  @@unique([communityId, code])
  @@unique([communityId, name])
  @@index([communityId])
  @@map("currencies")
}

/// One row per member per currency, holding the authoritative balance.
///
/// The balance is stored rather than summed from the ledger because it is read
/// on every page that shows a price and written far less often. It is only ever
/// written by an atomic increment inside the same transaction as the ledger row
/// that explains it, and `currency_transactions.balance_after` records what the
/// increment returned -- so the two can be checked against each other rather
/// than merely trusted.
model CurrencyBalance {
  id         String @id @default(uuid())
  currencyId String @map("currency_id")
  userId     String @map("user_id")

  /// Non-negative, enforced by a CHECK constraint rather than by application
  /// code. A read-then-write balance check races; the constraint does not.
  amount Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([currencyId, userId])
  @@index([userId])
  @@index([currencyId, amount])
  @@map("currency_balances")
}

enum CurrencyTransactionKind {
  /// Created into a member's balance by staff. Coin has no source but this.
  MINT
  /// Removed from a member's balance by staff, as a correction or a penalty.
  BURN
  /// Moved between two members. Writes one row per side, sharing a batch id.
  TRANSFER
  /// Spent by the member at a sink. Leaves circulation; there is no treasury.
  SPEND
  /// Written once, by a migration, for a balance that predates this ledger.
  IMPORT
}

/// What caused a currency movement.
///
/// The reason string says why in words; this says what in a form a query can
/// follow. Without it a member reading "+25, upload approved" has no way to
/// reach the upload, and staff auditing forty approvals cannot tell the rows
/// apart at all. The item ledger never had this problem because every
/// ItemTransaction names its item.
enum CurrencyTransactionSource {
  /// A member or staff acted directly, with no other record behind it.
  DIRECT
  /// Spent buying something from the community shop. Source id is the
  /// purchase LINE, not the purchase: a line is refundable a unit at a time,
  /// so a refund needs something more precise than the order to point at.
  SHOP_PURCHASE
  /// Awarded when an uploaded piece of media was approved in moderation.
  /// Source id is the MEDIA, not the image inside it: an image is an
  /// implementation detail of a media, so a media that has been deleted means
  /// the upload is gone as far as anyone is concerned, and pointing at the
  /// surviving image would name something with no user-facing existence.
  MEDIA_APPROVAL
  /// Paid out when a member used an item up. Source id is the ITEM, not its
  /// type: the item is the thing that was destroyed to produce this coin, and
  /// it is what the matching USE row on the item ledger names too, so the two
  /// halves of one event point at the same object.
  ITEM_USE
}

/// One member's side of one currency movement. A transfer is two rows.
///
/// `amount` is the signed delta applied to `userId`'s balance, so a member's
/// statement is this table filtered to them, and the community's total in
/// circulation is the sum of every row.
model CurrencyTransaction {
  id         String                  @id @default(uuid())
  currencyId String                  @map("currency_id")
  userId     String                  @map("user_id")
  kind       CurrencyTransactionKind

  /// Signed delta on this row's owner. Negative for BURN, SPEND, and the
  /// sending side of a TRANSFER.
  amount       Int
  /// The owner's balance immediately after this row was applied, as returned
  /// by the increment itself. Lets a statement show a running total without
  /// re-summing, and lets an audit find the exact row where the two diverged.
  balanceAfter Int @map("balance_after")

  /// Shared by every row one operation wrote -- both legs of a transfer, or
  /// every member in a bulk mint.
  batchId String @map("batch_id")

  /// The member on the other side of a transfer. Null for every other kind.
  counterpartyId String? @map("counterparty_id")
  /// Who performed it. Null for anything the system did on its own.
  actorUserId    String? @map("actor_user_id")
  /// Names a non-user actor: "discord-bot", "system". Set exactly when
  /// actorUserId is null.
  actorLabel     String? @map("actor_label") @db.VarChar(50)

  /// Member-facing, and readable by anyone who can read this statement.
  reason    String? @db.Text
  /// Staff-only. Nulled for viewers without item permissions in this
  /// community, and excluded from search, exactly as on the item ledger.
  staffNote String? @map("staff_note") @db.Text

  /// What caused this row. DIRECT means somebody simply did it.
  source   CurrencyTransactionSource @default(DIRECT)
  /// The id of the record named by `source` -- a media id for MEDIA_APPROVAL.
  ///
  /// Deliberately not a foreign key: it points at a different table depending
  /// on `source`, and a ledger row must outlive the thing that caused it. A
  /// cascade from a deleted image that erased the coin it created would be a
  /// far worse bug than a dangling id.
  sourceId String?                   @map("source_id")

  createdAt DateTime @default(now()) @map("created_at")

  currency     Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  user         User     @relation("CurrencyTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  counterparty User?    @relation("CurrencyTransactionCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  actorUser    User?    @relation("CurrencyTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([currencyId, createdAt])
  @@index([userId, createdAt])
  @@index([currencyId, userId, createdAt])
  @@index([batchId])
  /// Answers "what did approving this media pay out", which is the audit
  /// direction moderation needs. Partial-ish in practice: most rows are
  /// DIRECT with a null sourceId.
  @@index([source, sourceId])
  @@map("currency_transactions")
}

/// Something a community sells for its own currency.
///
/// Backed by an ItemType, so buying grants a real item with real provenance
/// rather than a shop-only object that the inventory knows nothing about.
model ShopItem {
  id          String @id @default(uuid())
  communityId String @map("community_id")
  itemTypeId  String @map("item_type_id")

  /// Defaults to the item type's name when blank, but a shop listing often
  /// wants its own wording ("Trait Change Potion (limit 1)").
  name        String? @db.VarChar(100)
  description String? @db.Text

  /// Null means unlimited. Zero means sold out, which is different from
  /// unavailable -- a sold-out listing still says what it was.
  stock      Int?
  /// Null means no cap. Counted across every purchase, not per checkout.
  maxPerUser Int? @map("max_per_user")

  /// Hidden from members without being deleted, so its purchase history and
  /// the items it granted keep their meaning.
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  itemType  ItemType           @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  prices    ShopPrice[]
  lines     ShopPurchaseLine[]

  @@index([communityId, active, sortOrder])
  @@map("shop_items")
}

/// One way to pay for a shop item.
///
/// An item can have several, and a buyer picks exactly one and pays all of it:
/// "5 Clover" OR "2 Clover and 1 Star" OR "3 Star". Mixing across options, or
/// paying part of one, is not a thing.
model ShopPrice {
  id         String @id @default(uuid())
  shopItemId String @map("shop_item_id")
  sortOrder  Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  shopItem   ShopItem             @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  components ShopPriceComponent[]
  lines      ShopPurchaseLine[]

  @@index([shopItemId, sortOrder])
  @@map("shop_prices")
}

/// One currency and how much of it a price option asks for.
model ShopPriceComponent {
  id          String @id @default(uuid())
  shopPriceId String @map("shop_price_id")
  currencyId  String @map("currency_id")
  amount      Int

  shopPrice ShopPrice @relation(fields: [shopPriceId], references: [id], onDelete: Cascade)
  currency  Currency  @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  /// One entry per currency per option: "5 Clover and 3 more Clover" is a
  /// single amount, not two components.
  @@unique([shopPriceId, currencyId])
  @@map("shop_price_components")
}

/// What using one of an item type pays its holder.
///
/// A row of its own rather than columns on `ItemType`, for the same reason
/// prices are: a payout is a set of currencies, and two nullable columns can
/// only ever describe one. A redemption ticket worth 100 coin and a seasonal
/// one worth 100 coin plus 2 event tokens are the same feature.
///
/// Optional -- most item types pay nothing, and a missing row says so more
/// plainly than a zero would.
model ItemUsePayout {
  id String @id @default(uuid())

  /// One payout per item type. Using is not a choice between rewards the way
  /// buying is a choice between prices: the holder presses Use and gets what
  /// the type pays.
  itemTypeId String @unique @map("item_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemType   ItemType                 @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  components ItemUsePayoutComponent[]

  @@map("item_use_payouts")
}

/// One currency and how much of it a use pays out.
model ItemUsePayoutComponent {
  id         String @id @default(uuid())
  payoutId   String @map("payout_id")
  currencyId String @map("currency_id")
  amount     Int

  payout   ItemUsePayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  /// Restrict, matching the shop's price components: a currency that something
  /// still pays out in cannot be deleted out from under it.
  currency Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  /// One entry per currency per payout. "100 coin and 50 more coin" is a
  /// single amount, not two components.
  @@unique([payoutId, currencyId])
  @@map("item_use_payout_components")
}

/// What making a character with one of these is allowed to make.
///
/// The second use effect, and shaped like the first: an effect row owned by an
/// item type, with N components under it. A ticket good for one Common and a
/// ticket good for any of Common, Uncommon or Rare are the same feature, and a
/// single variant column could only describe the first.
///
/// One species per ticket. The species is on the grant rather than inferred
/// from the variants so a grant is never ambiguous mid-edit, and so the "these
/// variants all belong to that species" rule has something to check against.
///
/// A grant and a currency payout are mutually exclusive on one item type. An
/// item type does one thing when used; enforced when either is configured.
model ItemUseMyoGrant {
  id String @id @default(uuid())

  /// One grant per item type, for the same reason a payout is one per type:
  /// the holder redeems the ticket and gets what the type makes, rather than
  /// choosing between rewards.
  itemTypeId String @unique @map("item_type_id")

  speciesId String @map("species_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemType ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  /// Restrict, matching the payout's currency: a species that outstanding
  /// tickets can still make cannot be deleted out from under them.
  species  Species  @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  variants ItemUseMyoGrantVariant[]

  @@map("item_use_myo_grants")
}

/// One variant a ticket is allowed to make.
model ItemUseMyoGrantVariant {
  id               String @id @default(uuid())
  grantId          String @map("grant_id")
  speciesVariantId String @map("species_variant_id")

  grant          ItemUseMyoGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// Restrict, as above. Deleting a variant somebody holds a ticket for would
  /// leave that ticket pointing at nothing, which is discovered at redemption
  /// -- the worst place to discover it.
  speciesVariant SpeciesVariant  @relation(fields: [speciesVariantId], references: [id], onDelete: Restrict)

  /// One entry per variant per grant. Listing Common twice does not make it
  /// likelier.
  @@unique([grantId, speciesVariantId])
  @@map("item_use_myo_grant_variants")
}

/// Which characters an edit kit may change the traits of.
///
/// The third use effect, and one level deeper than the other two, because a
/// kit names *several* species where an MYO ticket names one. A kit good for
/// "any Thornwing, or a Rare Bramblecat" is a shape a single species column
/// cannot describe.
///
/// Deliberately not shared with ItemUseMyoGrant. They look adjacent and are
/// different products: one makes a character of a species you pick from a
/// list, the other changes an existing character you already own. Forcing one
/// model onto both was considered and declined.
model ItemUseTraitEditGrant {
  id String @id @default(uuid())

  /// One grant per item type, as with the other two effects.
  itemTypeId String @unique @map("item_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemType ItemType                       @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  species  ItemUseTraitEditGrantSpecies[]

  @@map("item_use_trait_edit_grants")
}

/// One species an edit kit covers, and optionally which of its variants.
///
/// **An empty variant list means every variant of this species**, including a
/// character that has no variant set at all. That is the common case -- a kit
/// for a species is the ordinary thing to sell -- so it is the state you get
/// by naming a species and stopping.
model ItemUseTraitEditGrantSpecies {
  id        String @id @default(uuid())
  grantId   String @map("grant_id")
  speciesId String @map("species_id")

  grant ItemUseTraitEditGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// Restrict, as everywhere else a use effect names something: a species
  /// outstanding kits can still edit cannot be deleted out from under them.
  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  variants ItemUseTraitEditGrantVariant[]

  @@unique([grantId, speciesId])
  @@map("item_use_trait_edit_grant_species")
}

/// One variant of one species an edit kit is limited to.
model ItemUseTraitEditGrantVariant {
  id               String @id @default(uuid())
  grantSpeciesId   String @map("grant_species_id")
  speciesVariantId String @map("species_variant_id")

  grantSpecies   ItemUseTraitEditGrantSpecies @relation(fields: [grantSpeciesId], references: [id], onDelete: Cascade)
  speciesVariant SpeciesVariant               @relation(fields: [speciesVariantId], references: [id], onDelete: Restrict)

  @@unique([grantSpeciesId, speciesVariantId])
  @@map("item_use_trait_edit_grant_variants")
}

/// One checkout.
///
/// The order exists mostly to group its lines and to date the refund window;
/// everything refundable is tracked on the lines, because a buyer can undo one
/// potion out of three.
model ShopPurchase {
  id          String @id @default(uuid())
  communityId String @map("community_id")
  buyerId     String @map("buyer_id")

  createdAt DateTime @default(now()) @map("created_at")

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  buyer     User               @relation("ShopPurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  lines     ShopPurchaseLine[]

  @@index([communityId, createdAt])
  @@index([buyerId, createdAt])
  @@map("shop_purchases")
}

/// One unit bought: one item, at one price, once.
///
/// Quantity lives in the number of rows rather than in a column, which is the
/// same call already made for items themselves. A line carrying `quantity: 3`
/// and a `refundedQuantity` cannot say *which* of the three went back, and a
/// refund that cannot name what it returned is the thing this whole design is
/// trying to avoid. Buying three potions is three lines; the UI groups them.
///
/// Both ledgers point their `sourceId` here, so the single item this granted
/// can be found rather than guessed at.
model ShopPurchaseLine {
  id          String  @id @default(uuid())
  purchaseId  String  @map("purchase_id")
  shopItemId  String  @map("shop_item_id")
  /// The option chosen at checkout. Kept even if the option is later edited
  /// or removed, which is why the amounts paid are copied onto the line.
  shopPriceId String? @map("shop_price_id")

  /// Set when this unit has been given back. Null means still bought.
  refundedAt   DateTime? @map("refunded_at")
  /// Who performed the refund -- the buyer within the undo window, or staff
  /// afterwards. Null exactly when refundedAt is null.
  refundedById String?   @map("refunded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  purchase   ShopPurchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  shopItem   ShopItem               @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  price      ShopPrice?             @relation(fields: [shopPriceId], references: [id], onDelete: SetNull)
  refundedBy User?                  @relation("ShopLineRefunder", fields: [refundedById], references: [id], onDelete: SetNull)
  costs      ShopPurchaseLineCost[]

  @@index([purchaseId])
  @@index([shopItemId])
  @@map("shop_purchase_lines")
}

/// What this line actually cost, in one currency, at the time.
///
/// Copied from the price option rather than read back through it: prices are
/// edited, and a refund three days later must return what was paid, not what
/// the item costs now.
model ShopPurchaseLineCost {
  id         String @id @default(uuid())
  lineId     String @map("line_id")
  currencyId String @map("currency_id")
  /// A line is one unit, so this is exactly what a refund returns.
  amount     Int

  line     ShopPurchaseLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  currency Currency         @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([lineId, currencyId])
  @@map("shop_purchase_line_costs")
}

model Species {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  communityId String   @map("community_id")
  hasImage    Boolean  @default(false) @map("has_image")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  characters      Character[]
  traits          Trait[]
  speciesVariants SpeciesVariant[]

  /// Item types whose tickets make a character of this species.
  myoGrants ItemUseMyoGrant[]
  /// Item types whose edit kits can change a character of this species.
  traitEditGrants ItemUseTraitEditGrantSpecies[]

  @@map("species")
}

model Trait {
  id                   String         @id @default(uuid())
  name                 String         @db.VarChar(100)
  valueType            TraitValueType @map("value_type")
  allowsMultipleValues Boolean        @default(false) @map("allows_multiple_values")
  allowsClarifier      Boolean        @default(false) @map("allows_clarifier")
  speciesId            String         @map("species_id")
  colorId              String?        @map("color_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  // Relations
  species          Species          @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  color            CommunityColor?  @relation(fields: [colorId], references: [id], onDelete: SetNull)
  enumValues       EnumValue[]
  traitListEntries TraitListEntry[]

  @@unique([speciesId, name])
  @@map("traits")
}

model EnumValue {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  order     Int      @default(0)
  traitId   String   @map("trait_id")
  colorId   String?  @map("color_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trait             Trait              @relation(fields: [traitId], references: [id], onDelete: Cascade)
  color             CommunityColor?    @relation(fields: [colorId], references: [id], onDelete: SetNull)
  enumValueSettings EnumValueSetting[]

  @@unique([traitId, name])
  @@unique([traitId, order])
  @@map("enum_values")
}

model SpeciesVariant {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  speciesId String   @map("species_id")
  colorId   String?  @map("color_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  species           Species            @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  color             CommunityColor?    @relation(fields: [colorId], references: [id], onDelete: SetNull)
  characters        Character[]
  traitListEntries  TraitListEntry[]
  enumValueSettings EnumValueSetting[]

  /// Every MYO grant that lists this variant as one a ticket can make.
  myoGrantVariants ItemUseMyoGrantVariant[]
  /// Every edit-kit grant limited to this variant.
  traitEditGrantVariants ItemUseTraitEditGrantVariant[]

  @@unique([speciesId, name])
  @@map("species_variants")
}

model TraitListEntry {
  id                    String         @id @default(uuid())
  traitId               String         @map("trait_id")
  speciesVariantId      String         @map("species_variant_id")
  order                 Int
  required              Boolean
  valueType             TraitValueType @map("value_type")
  defaultValueString    String?        @map("default_value_string") @db.VarChar(255)
  defaultValueInt       Int?           @map("default_value_int")
  defaultValueTimestamp DateTime?      @map("default_value_timestamp") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  // Relations
  trait          Trait          @relation(fields: [traitId], references: [id], onDelete: Cascade)
  speciesVariant SpeciesVariant @relation(fields: [speciesVariantId], references: [id], onDelete: Cascade)

  @@unique([traitId, speciesVariantId])
  @@map("trait_list_entries")
}

model EnumValueSetting {
  id               String   @id @default(uuid())
  enumValueId      String   @map("enum_value_id")
  speciesVariantId String   @map("species_variant_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  enumValue      EnumValue      @relation(fields: [enumValueId], references: [id], onDelete: Cascade)
  speciesVariant SpeciesVariant @relation(fields: [speciesVariantId], references: [id], onDelete: Cascade)

  @@unique([enumValueId, speciesVariantId])
  @@map("enum_value_settings")
}

model ImageModerationAction {
  id          String                     @id @default(uuid())
  imageId     String                     @map("image_id")
  moderatorId String                     @map("moderator_id")
  action      ModerationStatus
  reason      ModerationRejectionReason?
  reasonText  String?                    @map("reason_text") @db.Text
  createdAt   DateTime                   @default(now()) @map("created_at")

  // Relations
  image     Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  moderator User  @relation("ModeratorActions", fields: [moderatorId], references: [id])

  @@index([imageId])
  @@index([moderatorId])
  @@map("image_moderation_actions")
}

model TraitReview {
  id          String            @id @default(uuid())
  characterId String            @map("character_id")
  status      ModerationStatus  @default(PENDING)
  source      TraitReviewSource

  /// [CharacterTraitValuesJson]
  proposedTraitValues Json  @map("proposed_trait_values")
  /// [CharacterTraitValuesJson]
  previousTraitValues Json  @map("previous_trait_values")
  /// [CharacterTraitValuesJson]
  appliedTraitValues  Json? @map("applied_trait_values")

  resolvedAt      DateTime? @map("resolved_at")
  resolvedById    String?   @map("resolved_by_id")
  rejectionReason String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  character  Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("TraitReviewResolver", fields: [resolvedById], references: [id])

  @@index([characterId])
  @@index([status])
  @@map("trait_reviews")
}

/// What happened. Each kind names the shape of `Notification.data`; the two are
/// kept in step by `notification-payloads.ts`, which will not compile if a kind
/// added here has no payload schema.
enum NotificationKind {
  /// Someone followed you. The actor is the whole story; there is no subject.
  FOLLOW_RECEIVED
  /// Someone commented on something of yours.
  COMMENT_RECEIVED
  /// Staff gave you one or more of an item type.
  ITEM_GRANTED
  /// Staff took one or more items back.
  ITEM_REVOKED
  /// Currency reached your balance.
  CURRENCY_RECEIVED
  /// Someone offered you a trade.
  TRADE_OFFERED
  /// A trade you proposed was accepted and has settled.
  TRADE_ACCEPTED
  /// A trade you proposed was declined.
  TRADE_DECLINED
}

/// What clicking a notification opens.
///
/// Deliberately not modelled as foreign keys. The row already carries
/// everything it needs to render, so a deleted subject should leave a dead link
/// and an intact message rather than delete the notification -- the opposite of
/// what `Like` wants, because a like about a deleted thing is meaningless and a
/// notification about one is still something that happened to you.
enum NotificationSubjectType {
  CHARACTER
  COMMENT
  GALLERY
  IMAGE
  MEDIA
  ITEM
  CURRENCY
  USER
  TRADE
}

/// One notification, already addressed to one recipient. An event concerning
/// five people writes five rows: read state is per person, and the unread badge
/// has to be answerable with a single indexed count.
///
/// Rows are snapshots. Everything needed to render one is captured at write
/// time in `data`, so the feed reads without joining five tables and a
/// notification about a since-deleted item still says what happened.
model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  kind        NotificationKind

  /// Who caused it. Null for anything the system did on its own.
  actorUserId String? @map("actor_user_id")
  /// Names a non-user actor: "system", "discord-bot". Set exactly when
  /// actorUserId is null.
  actorLabel  String? @map("actor_label") @db.VarChar(50)
  /// Set when the notification belongs to one community. Null for global kinds
  /// like a new follower.
  communityId String? @map("community_id")

  /// Free text, for the kinds that carry it. A mod message will be mostly this.
  body String? @db.Text

  /// Display values captured at write time -- subject name, counts, amounts.
  /// The shape is per-kind, and validated by zod on the way in and on the way
  /// back out.
  /// [NotificationDataJson]
  data Json @default("{}")

  subjectType NotificationSubjectType? @map("subject_type")
  subjectId   String?                  @map("subject_id")

  /// When the badge last stopped counting this. Set in bulk for everything
  /// unseen when the recipient opens the dropdown.
  seenAt    DateTime? @map("seen_at")
  /// When the recipient opened this particular one.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  recipient User       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorUser User?      @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  /// The feed, newest first.
  @@index([recipientId, createdAt])
  /// The badge count -- the only query here that runs on a timer.
  @@index([recipientId, seenAt])
  @@map("notifications")
}

/// Where an offer stands.
///
/// There is no EXPIRED value on purpose. Expiry is a date, and a stored status
/// that has to be flipped by a job is a status that is wrong between the moment
/// it lapses and the moment the job next runs. A PENDING trade past its
/// `expiresAt` reads as expired and refuses to settle; nothing has to sweep.
enum TradeStatus {
  /// Sent, unanswered, and not yet past `expiresAt`.
  PENDING
  /// Settled. Items and coin have moved and the ledgers say so.
  ACCEPTED
  /// The recipient said no.
  DECLINED
  /// The proposer withdrew it.
  CANCELLED
}

/// One member's offer to another: some items and characters each way, and coin.
///
/// Nothing is escrowed while an offer stands. Items, characters and balances
/// are checked when it is composed and checked again when it is accepted, and
/// only the second check decides anything -- so an offer never holds property
/// hostage, and a declined or abandoned offer needs nothing released. The cost
/// is that an offer can become unhonourable while it sits, which settlement
/// reports rather than prevents.
model Trade {
  id          String      @id @default(uuid())
  communityId String      @map("community_id")
  proposerId  String      @map("proposer_id")
  recipientId String      @map("recipient_id")
  status      TradeStatus @default(PENDING)

  /// Member-facing note from the proposer. Read by the recipient, and by
  /// anyone who can see the trade afterwards.
  note String? @db.Text

  /// When this stops being acceptable. Compared at read and re-compared at
  /// settlement; never written to `status`.
  expiresAt DateTime @map("expires_at")

  /// When it was accepted, declined or cancelled. Null exactly while PENDING.
  respondedAt DateTime? @map("responded_at")

  /// The batch id shared by every ledger row settlement wrote, across the item
  /// ledger, the currency ledger and the character ownership log. Null until
  /// accepted. This is what makes a trade traceable to its consequences
  /// without storing those consequences twice.
  settlementBatchId String? @map("settlement_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community      Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  proposer       User                @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipient      User                @relation("TradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  items          TradeItem[]
  characterLines TradeCharacter[]
  currencyLines  TradeCurrencyLine[]

  /// Both inboxes: "offers waiting on me" and "offers I have out".
  @@index([recipientId, status, createdAt])
  @@index([proposerId, status, createdAt])
  @@index([communityId, createdAt])
  @@map("trades")
}

/// One item on the table, and which way it moves.
///
/// `sourceUserId` and `destinationUserId` rather than a side flag: a line
/// becomes an `ItemTransaction` at settlement and that row is shaped the same
/// way, so settlement copies rather than translates. It also means a line reads
/// on its own, without joining the trade to find out who the parties are.
model TradeItem {
  id      String @id @default(uuid())
  tradeId String @map("trade_id")

  /// Names one specific row, because its history is the point. Set on every
  /// line the proposer offers -- they are at the composer, so they choose --
  /// and on a request for one particular storied copy.
  itemId String? @map("item_id")

  /// Set together, for a line that will accept any rows of this type. The
  /// default for anything requested: items of a type differ only by history, so
  /// pinning a row makes an offer fail for a reason neither party can see, when
  /// an identical one is sitting right there.
  ///
  /// Always sourced from the recipient. The giver chooses which rows to hand
  /// over, and the recipient is the only giver who has not chosen yet -- the
  /// proposer already did, at the composer.
  itemTypeId String? @map("item_type_id")
  quantity   Int?

  /// Who hands it over. Stored rather than derived from `Item.ownerId`: if the
  /// item changes hands while the offer sits, deriving would silently flip
  /// which way the trade points. Settlement compares this against the item's
  /// real owner and refuses when they disagree.
  sourceUserId      String @map("source_user_id")
  destinationUserId String @map("destination_user_id")

  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  item            Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemType        ItemType? @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  sourceUser      User      @relation("TradeItemSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  destinationUser User      @relation("TradeItemDestination", fields: [destinationUserId], references: [id], onDelete: Cascade)

  /// The same row cannot be on the table twice in one trade. By-type lines are
  /// not covered by this -- two lines for the same type would be one line with
  /// a larger quantity, and the service merges them on write.
  @@unique([tradeId, itemId])
  @@index([itemId])
  @@index([itemTypeId])
  @@map("trade_items")
}

/// One character on the table, and which way it moves.
///
/// A table of its own rather than a third shape of `TradeItem`, because the
/// distinction that model is built around does not exist here. An item line is
/// a row or a type-and-quantity: copies of a type differ only by history, so
/// asking for any of them is the sensible default. A character has no type and
/// no copies -- there is one of it, and it is the one you meant. Folding that
/// in would widen `trade_items_row_or_type` to a third arm and leave `quantity`
/// meaningless on every character line.
///
/// `sourceUserId` and `destinationUserId` mirror `TradeItem` so settlement
/// copies rather than translates, and so a line reads on its own without
/// joining the trade to find out who the parties are.
model TradeCharacter {
  id          String @id @default(uuid())
  tradeId     String @map("trade_id")
  characterId String @map("character_id")

  /// Who hands it over. Stored rather than derived from `Character.ownerId`:
  /// if the character changes hands while the offer sits, deriving would
  /// silently flip which way the trade points. Settlement compares this
  /// against the character's real owner and refuses when they disagree.
  sourceUserId      String @map("source_user_id")
  destinationUserId String @map("destination_user_id")

  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceUser      User      @relation("TradeCharacterSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  destinationUser User      @relation("TradeCharacterDestination", fields: [destinationUserId], references: [id], onDelete: Cascade)

  /// The same character cannot be on the table twice in one trade. Unlike the
  /// item equivalent there is no by-type case to carve out, so this covers
  /// every character line there is.
  @@unique([tradeId, characterId])
  @@index([characterId])
  @@map("trade_characters")
}

/// Coin on the table, in one direction.
///
/// `amount` is always positive; direction is the source/destination pair rather
/// than a sign. Opposing amounts in the same currency are netted by the service
/// before they are written, so "give 250, ask 100 back" is stored once as 150 --
/// coin is fungible and the two halves have no separate meaning.
model TradeCurrencyLine {
  id         String @id @default(uuid())
  tradeId    String @map("trade_id")
  currencyId String @map("currency_id")
  amount     Int

  sourceUserId      String @map("source_user_id")
  destinationUserId String @map("destination_user_id")

  trade           Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  currency        Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  sourceUser      User     @relation("TradeCurrencySource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  destinationUser User     @relation("TradeCurrencyDestination", fields: [destinationUserId], references: [id], onDelete: Cascade)

  /// One line per currency per direction. With netting on write this means at
  /// most one line per currency in practice.
  @@unique([tradeId, currencyId, sourceUserId])
  @@map("trade_currency_lines")
}
