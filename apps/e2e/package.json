{
  "name": "@chardb/e2e",
  "version": "10.1.0",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "world": "tsx src/cli/world.ts",
    "build": "echo '@chardb/e2e: nothing to build'",
    "test": "echo '@chardb/e2e: browser suite is opt-in, run `yarn workspace @chardb/e2e e2e`'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .artifacts playwright-report test-results"
  },
  "dependencies": {
    "@chardb/database": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
