{
  "name": "@chardb/e2e",
  "version": "11.4.0",
  "private": true,
  "scripts": {
    "e2e": "yarn codegen && playwright test",
    "e2e:ui": "yarn codegen && playwright test --ui",
    "e2e:headed": "yarn codegen && playwright test --headed",
    "e2e:report": "playwright show-report",
    "world": "yarn codegen && tsx src/cli/world.ts",
    "build": "echo '@chardb/e2e: nothing to build'",
    "test": "echo '@chardb/e2e: browser suite is opt-in, run `yarn workspace @chardb/e2e e2e`'",
    "type-check": "yarn codegen && tsc --noEmit",
    "clean": "rm -rf .artifacts playwright-report test-results src/generated",
    "codegen": "graphql-codegen --config .graphqlrc.yml"
  },
  "dependencies": {
    "@chardb/database": "workspace:*",
    "bcrypt": "^5.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typed-document-node": "^5.0.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.50.0",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "graphql": "^16.8.0",
    "pg": "^8.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
