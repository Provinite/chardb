# Test Database Configuration
DATABASE_URL="postgresql://test_user:test_password@localhost:5440/chardb_test"

# JWT Configuration
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_REFRESH_SECRET="test-refresh-secret-key-for-testing-only"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Test Environment
NODE_ENV="test"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting (disabled for tests)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# Discord (mock values — bot calls will fail gracefully in tests)
DISCORD_BOT_TOKEN="test-discord-bot-token"
DISCORD_CLIENT_ID="000000000000000001"
DISCORD_CLIENT_SECRET="test-discord-client-secret"
DISCORD_GUILD_ID="000000000000000002"

# DeviantArt OAuth (mock values)
DEVIANTART_CLIENT_ID="test-deviantart-client-id"
DEVIANTART_CLIENT_SECRET="test-deviantart-client-secret"

# AWS / S3 (mock values — no real uploads in tests)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="chardb-test"
AWS_ACCESS_KEY_ID="test-access-key"
AWS_SECRET_ACCESS_KEY="test-secret-key"
AWS_ENDPOINT_URL="http://localhost:4566"

# SQS (disabled for tests)
AWS_SQS_ENABLED="false"
AWS_SQS_QUEUE_URL="http://localhost:4566/000000000000/test-queue"

# Email -- pinned to loopback so a test run can never reach a real relay.
#
# These were MAIL_HOST/MAIL_PORT/MAIL_FROM, which nothing reads: EmailModule
# wants SMTP_HOST/SMTP_PORT/EMAIL_FROM. With SMTP_HOST unset the module falls
# through to its SES branch, and the suite's behaviour then depended on whether
# the developer happened to have an apps/backend/.env -- which the e2e backend
# picks up, because ConfigModule loads .env from its cwd. Locally that quietly
# routed test mail through whatever host that file named; on CI, where .env
# does not exist, it attempted SES instead.
#
# 127.0.0.1 is the guarantee, not the port. Loopback cannot deliver offsite
# whatever is or is not listening. Port 1025 is MailHog, so when `yarn
# shared:up` is running the mail a test sends is readable at localhost:8025;
# when it is not, the connection is refused and EmailService swallows it.
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
EMAIL_FROM="test@chardb.test"

# ToyHouse OAuth (mock values)
TOYHOUSE_CLIENT_ID="test-toyhouse-client-id"
TOYHOUSE_CLIENT_SECRET="test-toyhouse-client-secret"
