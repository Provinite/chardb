# API Configuration
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# App Configuration
VITE_APP_NAME=CharDB
VITE_APP_VERSION=1.0.0

# The domain communities are served from. `chardb.cc` in production;
# `dev.localhost` locally, where browsers resolve every *.localhost label to
# loopback with no /etc/hosts entry -- so `willowmere.dev.localhost:3000`
# reaches the community. The spare label matters: see ROOT_DOMAIN in the
# backend's .env.example. `scripts/instance.mjs` injects this.
VITE_ROOT_DOMAIN=dev.localhost

# Slot 0 gets no injected environment, so it needs these by hand. The API must
# be under the root domain or the session cookie never reaches it.
VITE_API_URL=http://api.dev.localhost:4000
